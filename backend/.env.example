NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/daybook
JWT_SECRET=supersecretjwtkey_replace_me_in_production
FRONTEND_URL=http://localhost:5173

# Email Configuration
# Option 1: Gmail (Recommended for development - no domain needed)
# 1. Enable 2FA on your Google Account
# 2. Go to Security -> App Passwords and generate a new password
# 3. Use those credentials below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
EMAIL_FROM="Daybook <your-email@gmail.com>"

# Option 2: Resend (Requires verifying a domain for production)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key_here
# EMAIL_FROM="Daybook <onboarding@resend.dev>"
